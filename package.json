{
  "name": "dont-dimmadeck",
  "version": "1.0.0",
  "description": "Keep the Steam Deck screen awake on a per-app basis",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "package": "rollup -c && ./scripts/package.sh",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import ./test/ts-resolve.mjs \"test/**/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaxonWright/decky-dont-dimmadeck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "screen-timeout",
    "screen-dim"
  ],
  "author": "Jaxon Wright",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/JaxonWright/decky-dont-dimmadeck/issues"
  },
  "homepage": "https://github.com/JaxonWright/decky-dont-dimmadeck#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
